# Odoo Connection Configuration for redoxyae
# URL of your Odoo instance (without trailing slash)
ODOO_URL=https://redoxyae.odoo.com

# Database name
ODOO_DB=redoxyae

# Your Odoo user login email
ODOO_USER=your-email@example.com

# Your Odoo API Key (Recommended) or account password
# Generate an API key: User Avatar -> Preferences -> Account Security -> Developer API Keys -> New API Key
ODOO_API_KEY=your_odoo_api_key_here
